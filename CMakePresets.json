{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    { "name": "desktop", "displayName": "Desktop (C++20 + Qt 6)", "generator": "Ninja", "binaryDir": "${sourceDir}/build/desktop", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON", "TRAFFICSIM_BUILD_DESKTOP": "ON" } },
    { "name": "headless", "displayName": "Core + CLI (no Qt)", "inherits": "desktop", "binaryDir": "${sourceDir}/build/headless", "cacheVariables": { "TRAFFICSIM_BUILD_DESKTOP": "OFF" } },
    { "name": "release", "inherits": "desktop", "binaryDir": "${sourceDir}/build/release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "desktop", "configurePreset": "desktop" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "desktop", "configurePreset": "desktop", "output": { "outputOnFailure": true } },
    { "name": "headless", "configurePreset": "headless", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
